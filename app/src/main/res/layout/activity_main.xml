<?xml version="1.0" encoding="utf-8"?>
<!--
Keeps the renderer switch outside the replaceable login view. MainActivity replaces the fragment in
login_container and uses the restored fragment to initialize use_compose after recreation. Window
and keyboard insets are applied to this root so both child implementations get the same usable area.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/use_compose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingHorizontal="24dp"
        android:text="@string/use_compose" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/login_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
